# ---------------------------------------------------------------------------
# Model source: lmstudio | gateway | cloud
#
# "gateway" points at an OpenAI-compatible router (OmniRoute, FreeLLMAPI,
# LiteLLM). The gateway owns fallback, load balancing and rate-limit handling;
# this app deliberately does not reimplement any of that.
# ---------------------------------------------------------------------------
RF_LLM_PROVIDER=lmstudio

# Local (LM Studio)
RF_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
RF_LMSTUDIO_MODEL=qwen3-27b

# Gateway. With OmniRoute, put your local model in tier 1 so cloud providers are
# only reached when local is unavailable. Model names are "provider/model".
RF_GATEWAY_BASE_URL=http://127.0.0.1:20128/v1/chat/completions
RF_GATEWAY_MODEL=
RF_GATEWAY_API_KEY=

# A single provider, no gateway
RF_CLOUD_BASE_URL=
RF_CLOUD_MODEL=
RF_CLOUD_API_KEY=

# ---------------------------------------------------------------------------
# Generation
# ---------------------------------------------------------------------------
# Qwen3-style reasoning is uncapped and invisible; leave this on unless the model
# needs thinking to answer well. Run `python -m rfactory.bench` to see the cost.
RF_DISABLE_THINKING=true
# Grammar-constrained JSON. Turn off only if your server rejects response_format.
RF_STRUCTURED_OUTPUT=true
RF_REQUEST_TIMEOUT=180

RF_LATEX_ENGINE=pdflatex
RF_MAX_PAGES=1

# ---------------------------------------------------------------------------
# Serving
# ---------------------------------------------------------------------------
# Set automatically by ./serve.sh from your Tailscale name. Only set it by hand if
# you are not using serve.sh. It is compiled into the frontend, so it must be an
# address the BROWSER can reach -- localhost works only on this machine.
# RF_PUBLIC_HOST=your-mac.tailnet-name.ts.net
