<# Generated resume. Jinja delimiters are << >> and <% %> so LaTeX braces pass through.
   TLCresume.sty is copied in alongside this file at compile time.
   ATS layout rules: contact details live in the body (many parsers skip page headers),
   one column, standard section names, skills as plain lines rather than a table. #>
\documentclass[10pt]{article}
\usepackage[utf8]{inputenc}
\usepackage{TLCresume}

\begin{document}
\bodyfont

% A group with \centering instead of a center environment: center adds a line
% of padding below the contact details.
{\centering
{\LARGE\bfseries << profile.name|tex >>}\\[2pt]
<< profile.location|tex >> \textbar\ << profile.phone|tex >> \textbar\ \href{mailto:<< profile.email >>}{<< profile.email >>} \textbar\ \href{https://www.linkedin.com/in/<< profile.linkedin >>}{linkedin.com/in/<< profile.linkedin >>} \textbar\ \href{https://github.com/<< profile.github >>}{github.com/<< profile.github >>}<% if profile.portfolio_url %> \textbar\ \href{<< profile.portfolio_url >>}{<< profile.portfolio_name|tex >>}<% endif %>\par}
\vspace{2pt}

<% if objective %>
\section{Summary}
<< objective|tex >>
<% endif %>

<% if professional %>
\section{Professional Experience}
<% for role in professional %>
\role{<< role.title|tex >>}{<< role.org|tex >>}{<< role.location|tex >>}{<< role.date_range >>}
\begin{zitemize}
<% for bullet in role.bullets %>
    \item << bullet|tex >>
<% endfor %>
\end{zitemize}
<% endfor %>
<% endif %>

<% if additional %>
\section{Additional Experience}
<% for role in additional %>
\role{<< role.title|tex >>}{<< role.org|tex >>}{<< role.location|tex >>}{<< role.date_range >>}
\begin{zitemize}
<% for bullet in role.bullets %>
    \item << bullet|tex >>
<% endfor %>
\end{zitemize}
<% endfor %>
<% endif %>

<% if projects %>
\section{Projects}
<% for project in projects %>
\textbf{<< project.name|tex >>}
\begin{zitemize}
<% for bullet in project.bullets %>
    \item << bullet|tex >>
<% endfor %>
\end{zitemize}
<% endfor %>
<% endif %>

<% if skills %>
\section{Technical Skills}
<% for group in skills %>
\textbf{<< group.label|tex >>:} << group.entries|join(', ')|tex >>\par
<% endfor %>
<% endif %>

<% if education %>
\section{Education}
<% for item in education %>
\textbf{<< item.credential|tex >>}, << item.institution|tex >>, << item.location|tex >> \hfill << item.date_range >>\par
<% endfor %>
<% endif %>

<% if certifications %>
\section{Certifications}
<% for cert in certifications %>
<< cert.name|tex >> \textbar\ << cert.issuer|tex >>\par
<% endfor %>
<% endif %>

<% if activities %>
\section{Activities}
<% for item in activities %>
<< item.title|tex >> \hfill << item.dates|tex >>\par
<% endfor %>
<% endif %>

\end{document}
